# Copy this file to /opt/proxyparser/deploy/.env on the server.
IMAGE_TAG=local
PROXYPARSER_DATA_DIR=/var/lib/proxyparser
# 必填：订阅链接与 /rs 资源的真实对外地址（不带末尾斜杠）。
# 模板故意留空；部署脚本会拒绝空值与 example.com 占位域名。
PUBLIC_BASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
# 可选：64 位 hex 数据密钥；留空时使用持久化目录中的 .secret-key。
PP_SECRET_KEY=
JWT_ISSUER=proxyparser
DEFAULT_LOCALE=zh-CN
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
SUBSCRIPTION_TEMP_TOKEN_TTL_SECONDS=86400
SOURCE_SYNC_INTERVAL_MINUTES=360
