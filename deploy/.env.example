# Copy this file to /opt/proxyparser/deploy/.env on the server.
IMAGE_TAG=local
PROXYPARSER_DATA_DIR=/var/lib/proxyparser
# 订阅链接与 /rs 资源的对外可访问地址（不带末尾斜杠）
PUBLIC_BASE_URL=https://proxyparser.example.com
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=proxyparser
DEFAULT_LOCALE=zh-CN
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
SUBSCRIPTION_TEMP_TOKEN_TTL_SECONDS=86400
